{
  "name": "flash-sale-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env src/api/server.ts",
    "start": "node --env-file=../.env src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:oversell": "node --env-file=../.env src/scripts/oversell-demo.ts",
    "worker": "node --env-file=../.env src/worker/main.ts",
    "seed": "node --env-file=../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
