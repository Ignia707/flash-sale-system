{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Node 24 runs .ts files directly by stripping the types, so we never compile.
    // TypeScript is only here to check our types (pnpm typecheck).
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true
  },
  "include": ["src", "test", "vitest.config.ts"]
}
