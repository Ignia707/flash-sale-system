# Copy this file to .env and adjust
# Local development passwords only

# --- PostgreSQL ---
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash_dev_pw
POSTGRES_DB=flashsale
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=flash
RABBITMQ_PASSWORD=flash_dev_pw
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Backend API ---
API_PORT=3000
POSTGRES_HOST=localhost
REDIS_HOST=localhost
RABBITMQ_HOST=localhost

# --- Guest tokens and sale window ---
JWT_SECRET=dev-only-secret-change-me-please
# Sale opens at this time (UTC). Leave unset for "open all the time".
# SALE_STARTS_AT=2026-11-01T10:00:00Z

# --- Full stack (podman-compose --profile app up -d --build) ---
API_REPLICAS=3
HTTP_PORT=8080
LOG_LEVEL=info
