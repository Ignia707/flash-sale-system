# Front door: balances the API replicas, limits abusive clients, serves the static page.
# ${...} values are filled in from the container's environment (see compose.yaml).

upstream api {
  zone api 64k;                # share the replicas' state between NGINX's worker processes
  least_conn;                  # send each request to the replica with the fewest active ones
  # the name resolves to every replica; one that fails 3 times within 10 s is skipped for 10 s
  # (a single slow connection under heavy load must not take a healthy replica out)
  server api:3000 max_fails=3 fail_timeout=10s;
  keepalive 64;                # reuse connections to the replicas
}

# One bucket per client IP, only for the two endpoints that must not be hammered.
# An empty key means "not limited".
map $uri $session_key  { default ""; "/api/session"  $binary_remote_addr; }
map $uri $checkout_key { default ""; "/api/checkout" $binary_remote_addr; }
limit_req_zone $session_key  zone=session:10m  rate=${RATE_SESSION}r/s;
limit_req_zone $checkout_key zone=checkout:10m rate=${RATE_CHECKOUT}r/s;
limit_req_status 429;

gzip on;
gzip_comp_level 6;
gzip_types application/json text/css text/javascript application/javascript image/svg+xml;

server {
  listen 80 backlog=4096;      # room for a burst of new connections

  location /api/ {
    limit_req zone=session  burst=${BURST_SESSION}  nodelay;
    limit_req zone=checkout burst=${BURST_CHECKOUT} nodelay;

    proxy_pass http://api;
    proxy_connect_timeout 2s;      # a dead replica costs two seconds, not the default minute
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    add_header Cache-Control "no-store" always;
  }

  location = /health {
    proxy_pass http://api;
    proxy_connect_timeout 2s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    add_header Cache-Control "no-store" always;
  }

  # files with a hash in their name never change: cache them for a year
  location /assets/ {
    root /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # the page itself: always re-check, so a new deploy shows up immediately
  location / {
    root /usr/share/nginx/html;
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
